<% @page_title = "Agent Settings — #{@column.name}" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= link_to "← Back to Board", @column.board %>
  </div>

  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<section class="settings">
  <div class="settings__panel panel shadow">
    <div class="settings__section">
      <h3 class="settings__section-title">Column Agent Settings</h3>
      <p class="settings__section-description">
        Configure how AI agents behave when cards are moved into this column.
      </p>

      <%= form_with model: @agent_config,
            url: column_agent_config_path(@column),
            method: :patch do |f| %>
        <% if @agent_config.errors.any? %>
          <div class="alert">
            <% @agent_config.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="settings__section">
          <%= f.label :system_prompt, "Column Instructions" %>
          <p class="settings__section-description">Extra context given to agents working on cards in this column.</p>
          <%= f.text_area :system_prompt,
                class: "input",
                rows: 6,
                placeholder: "e.g. Cards in this column are ready for implementation. Write code, run tests, open a PR." %>
        </div>

        <div class="settings__section">
          <label class="checkbox">
            <%= f.check_box :auto_spawn %>
            Auto-spawn agent when a card enters this column
          </label>
        </div>

        <div style="margin-top: 1rem">
          <%= f.submit "Save", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
